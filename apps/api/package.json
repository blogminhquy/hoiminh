{
  "name": "@hoiminh/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/node.ts",
    "dev:worker": "wrangler dev",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@hoiminh/config": "workspace:*",
    "@hoiminh/contracts": "workspace:*",
    "@hoiminh/core": "workspace:*",
    "@hoiminh/db": "workspace:*",
    "@hoiminh/email": "workspace:*",
    "@hoiminh/media": "workspace:*",
    "@hoiminh/payments": "workspace:*",
    "@hono/node-server": "^1.13.2",
    "@hono/zod-validator": "^0.4.1",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241011.0",
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2",
    "wrangler": "^3.80.4"
  }
}
