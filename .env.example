# ===== Hội Mình · biến môi trường =====
# Sao chép thành .env ở thư mục gốc. Chạy local không cần điền gì: mặc định dùng PGlite + auth local + email ghi log.

# --- Môi trường ---
APP_ENV=development                 # development | staging | production
APP_URL=http://localhost:5173       # địa chỉ web
API_URL=http://localhost:8787       # địa chỉ API
API_PORT=8787
LOG_LEVEL=info

# --- Cơ sở dữ liệu ---
# Local: để trống hoặc pglite://./.data/hoiminh (PGlite nhúng, không cần cài Postgres)
# Supabase: postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=pglite://./.data/hoiminh
DATABASE_DIRECT_URL=                # kết nối trực tiếp (cổng 5432) để chạy migration trên Supabase

# --- Auth ---
# AUTH_PROVIDER=local dùng mật khẩu băm trong DB (chỉ dev/test). AUTH_PROVIDER=supabase dùng Supabase Auth.
AUTH_PROVIDER=local
AUTH_JWT_SECRET=doi-chuoi-nay-o-production-toi-thieu-32-ky-tu
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- Mã hóa dữ liệu nhạy cảm (thông tin ngân hàng, credential cổng thanh toán) ---
# 32 byte base64. Sinh: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
ENCRYPTION_KEY_VERSION=1

# --- Email hệ thống (Resend). Để trống thì email được ghi ra log. ---
RESEND_API_KEY=
EMAIL_FROM="Hội Mình <no-reply@hoiminh.vn>"

# --- Tệp và ảnh (Cloudflare R2, giao thức S3). Để trống thì lưu vào .data/files ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=hoiminh-files
R2_PUBLIC_BASE_URL=

# --- Thanh toán: SePay (chuyển khoản QR) ---
SEPAY_MODE=sandbox                  # sandbox | production
SEPAY_API_KEY=                      # khóa xác thực webhook (header Authorization: Apikey ...)
SEPAY_BANK_CODE=VCB
SEPAY_BANK_ACCOUNT=0071000123456
SEPAY_ACCOUNT_HOLDER=HOI MINH JSC
SEPAY_QR_TEMPLATE=compact

# --- Thanh toán: MoMo ---
MOMO_MODE=sandbox
MOMO_PARTNER_CODE=MOMOTEST
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn

# --- Thanh toán: VNPAY ---
VNPAY_MODE=sandbox
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_ENDPOINT=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# --- Thanh toán: PayPal ---
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_USD_RATE=25000               # tỷ giá quy đổi VND→USD cho khách quốc tế

# --- Web (Vite chỉ đọc biến bắt đầu bằng VITE_) ---
VITE_API_URL=http://localhost:8787
VITE_APP_URL=http://localhost:5173
